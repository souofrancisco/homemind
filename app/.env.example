# Copiar para .env. Nunca commitar .env nem credenciais reais.
APP_MODE=simulation
DATABASE_PATH=./data/homemind-simulation.db
LLM_API_KEY=
# URL RTSP da câmara (ou caminho de um clip). Contém credenciais: nunca logar nem commitar.
VIDEO_SOURCE=
# --- MCP Altice (HOME_BACKEND=mcp); ver docs/mcp-demo.md ---
# MCP_ENDPOINT=  /  MCP_API_KEY= (segredo, nunca logar)  /  MCP_CLIENT_TYPE=core
MCP_ENDPOINT=
MCP_API_KEY=
MCP_CLIENT_TYPE=core
MCP_OAUTH_CLIENT_ID=mcp-client
MCP_OAUTH_CALLBACK_PORT=5434
MCP_OAUTH_CALLBACK_URL=http://mcp-redirect.futurelabsinnovations.com:5434/callback
# Tokens OAuth: diretoria 0700 (montada no container). Login só no host: make mcp-login
# MCP_TOKEN_PATH=app/.mcp-auth/tokens.json
# Porta do backend MCP isolado (make mcp-up)
MCP_BACKEND_PORT=18080
# Escritas físicas: duas chaves. 1) esta flag; 2) um grant temporário (make mcp-writes-on).
ENABLE_PHYSICAL_WRITES=false
# MCP_WRITE_GRANT_PATH=data/mcp-write-grant.json
# MCP_WRITE_MAX_MINUTES=60
# Só se o inventário tiver várias lâmpadas/tomadas elegíveis (nunca se escolhe uma ao acaso)
# MCP_LAMP_ID=
# MCP_PLUG_ID=
# Portas do host (opcional, se 8000/5173 ocupadas)
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Authentik (só dev; valores por defeito já funcionam em `make dev`)
AUTHENTIK_PORT=9000
# AUTHENTIK_SECRET_KEY=
# AUTHENTIK_DB_PASSWORD=
# AUTHENTIK_ADMIN_EMAIL=admin@homemind.local
# AUTHENTIK_ADMIN_PASSWORD=
# Motor ObjectOS (features/engine/config.py). PROFILE=demo: espera de 10 s em vez de 180 s.
# HOME_BACKEND=mcp = dispositivos reais Altice (/api/simulate fica bloqueado). Sem NVIDIA_API_KEY, /api/rules/parse dá 503.
PROFILE=normal
HOME_BACKEND=fake
# RULES_PATH=data/rules.json
# EVENTS_PATH=data/events.jsonl
# TARIFA_EUR_KWH=0.16
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b  (lista: GET https://integrate.api.nvidia.com/v1/models)
# Visão → motor (#28): Detetor da P1 (#4) como modulo:Classe. Sem ele (ou sem VIDEO_SOURCE),
# o servidor arranca sem visão. Teste sem YOLO: homemind.features.gestos.tests._fakes:DetetorDeClip
# VISAO_DETETOR=
