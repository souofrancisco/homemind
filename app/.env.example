# Copiar para app/.env. Nunca commitar .env nem credenciais reais.
# Sem alterações, `make dev` arranca em modo FakeHome (SIMULADO), sem câmara, YOLO, NVIDIA ou MCP.

# --- Motor (features/engine/config.py) ---
# fake = SIMULADO | mcp = dispositivos reais Altice (/api/simulate fica bloqueado)
HOME_BACKEND=fake
# normal = espera de 180 s até suspender | demo = 10 s
PROFILE=normal
# RULES_PATH=data/rules.json
# EVENTS_PATH=data/events.jsonl
# TARIFA_EUR_KWH=0.16
# NVIDIA_API_KEY=            # só para POST /api/rules/parse; sem ela responde 503
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Vídeo e visão (opcionais) ---
# URL RTSP da câmara ou caminho de um clip. Contém credenciais: nunca logar nem commitar.
VIDEO_SOURCE=
# Detetor como modulo:Classe. YOLO real (requer `uv sync --extra visao` + pesos, fora do Docker):
#   VISAO_DETETOR=homemind.features.visao.detetor:DetetorYolo
# Sem YOLO (SIMULADO): homemind.features.gestos.tests._fakes:DetetorDeClip
# VISAO_DETETOR=

# --- MCP Altice (só com HOME_BACKEND=mcp; ver docs/mcp-demo.md) ---
MCP_ENDPOINT=
MCP_API_KEY=
MCP_CLIENT_TYPE=core
MCP_OAUTH_CLIENT_ID=mcp-client
MCP_OAUTH_CALLBACK_PORT=5434
MCP_OAUTH_CALLBACK_URL=http://mcp-redirect.futurelabsinnovations.com:5434/callback
# Tokens OAuth: diretoria 0700 criada por `make mcp-login` (app/.mcp-auth/).
# MCP_TOKEN_PATH=app/.mcp-auth/tokens.json
# Porta do backend MCP isolado (make mcp-up)
MCP_BACKEND_PORT=18080
# Escritas físicas: duas chaves. 1) esta flag; 2) um grant temporário (make mcp-writes-on).
ENABLE_PHYSICAL_WRITES=false
# MCP_WRITE_GRANT_PATH=data/mcp-write-grant.json
# MCP_WRITE_MAX_MINUTES=60
# Só se o inventário tiver várias lâmpadas/tomadas elegíveis (nunca se escolhe uma ao acaso)
# MCP_LAMP_ID=
# MCP_PLUG_ID=
# Unidade de instantPower (o MCP não a declara): W, dW (0,1 W) ou mW. Vazio = consumo_w null.
# Confirmar com uma carga conhecida (docs/mcp-capabilities.md) antes de ativar.
# MCP_INSTANTPOWER_UNIT=
# Polling do MCP (s, mínimo 1) e atraso máximo com backoff exponencial após falhas seguidas.
# A tomada só atualiza de ~30 em ~30 s (e quando a carga muda): ver docs/integrations/mcp-capabilities.md.
# MCP_POLL_SECONDS=5
# MCP_POLL_BACKOFF_MAX_S=60

# --- Presença (PRES-03; ver docs/modules/presence.md) ---
# Sal do hash dos MACs dos telemóveis (segredo; gerar: python -c "import secrets;print(secrets.token_hex(32))").
# Vazio = registo de telemóveis e pistas Wi-Fi desligados.
PRESENCE_MATCH_SALT=
# off | simulated (MACs fictícios, SIMULADO) | arp (varre a rede a partir do backend: só no anfitrião,
# NUNCA no Docker) | ingest (recomendado com Docker: `make presence-wifi-scan` corre no anfitrião)
PRESENCE_WIFI_MODE=off
# Rede do hub do kit (só redes privadas, até /22), p. ex. 192.168.1.0/24
PRESENCE_WIFI_SUBNET=
# PRESENCE_WIFI_INTERVAL_S=30
# Modo simulated: MACs fictícios «vistos», por vírgulas (p. ex. 02:00:00:aa:00:01)
# PRESENCE_WIFI_SIM_ADDRESSES=
# Modo ingest: token que o varrimento no anfitrião envia (segredo; gerar como o sal)
PRESENCE_INGEST_TOKEN=

# --- Portas do host (mudar se ocupadas) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
AUTHENTIK_PORT=9000

# --- Authentik (só dev; os valores por omissão de app/compose.yaml já funcionam) ---
# AUTHENTIK_SECRET_KEY=
# AUTHENTIK_DB_PASSWORD=
# AUTHENTIK_ADMIN_EMAIL=admin@homemind.local
# AUTHENTIK_ADMIN_PASSWORD=
